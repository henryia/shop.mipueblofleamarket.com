# ═══════════════════════════════════════════════════════════════════════════
# shop.mipueblofleamarket.com — Variables de entorno
# Copia este archivo como .env y rellena los valores reales.
# NUNCA subas .env al repo. Ya está en .gitignore.
# ═══════════════════════════════════════════════════════════════════════════

# ─── APP ────────────────────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Mi Pueblo Shop"

# ─── BASE DE DATOS (PostgreSQL 16) ──────────────────────────────────────────
POSTGRES_USER=shop
POSTGRES_PASSWORD=shop_dev_password
POSTGRES_DB=shop_dev
DATABASE_URL="postgresql://shop:shop_dev_password@localhost:5432/shop_dev?schema=public"
# En producción usar pgbouncer con pool_mode=transaction:
# DATABASE_URL="postgresql://shop:PASSWORD@localhost:6432/shop_prod?schema=public&pgbouncer=true"

# ─── REDIS ──────────────────────────────────────────────────────────────────
REDIS_PASSWORD=redis_dev_password
REDIS_URL="redis://:redis_dev_password@localhost:6379"

# ─── AUTH (Auth.js / NextAuth) ───────────────────────────────────────────────
# Generar con: openssl rand -base64 32
NEXTAUTH_SECRET=REPLACE_WITH_SECURE_RANDOM_STRING_32_CHARS
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (obtener en console.cloud.google.com)
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET

# ─── STRIPE ─────────────────────────────────────────────────────────────────
# Dashboard: dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_STRIPE_SECRET_KEY
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_STRIPE_PUBLISHABLE_KEY
# Para webhooks: stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_STRIPE_WEBHOOK_SECRET
# Comisión de la plataforma en % (ej: 10 = 10%)
PLATFORM_COMMISSION_PCT=10

# ─── CLOUDFLARE R2 (Storage de medios) ──────────────────────────────────────
# Dashboard: dash.cloudflare.com → R2
CLOUDFLARE_ACCOUNT_ID=REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID
R2_ACCESS_KEY_ID=REPLACE_WITH_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=REPLACE_WITH_R2_SECRET_ACCESS_KEY
R2_BUCKET_NAME=shop-media
R2_PUBLIC_URL=https://media.shop.mipueblofleamarket.com
# Para dev local puedes usar MinIO: http://localhost:9000

# ─── EASYPOST (Logística) ────────────────────────────────────────────────────
# dashboard.easypost.com
EASYPOST_API_KEY=REPLACE_WITH_EASYPOST_API_KEY
EASYPOST_WEBHOOK_SECRET=REPLACE_WITH_EASYPOST_WEBHOOK_SECRET

# ─── RESEND (Email transaccional) ────────────────────────────────────────────
# resend.com/api-keys
RESEND_API_KEY=re_REPLACE_WITH_RESEND_API_KEY
EMAIL_FROM="Mi Pueblo Shop <noreply@shop.mipueblofleamarket.com>"
EMAIL_FROM_NAME="Mi Pueblo Shop"

# ─── SENTRY (Error tracking) ─────────────────────────────────────────────────
# sentry.io
SENTRY_DSN=https://REPLACE@REPLACE.ingest.sentry.io/REPLACE
NEXT_PUBLIC_SENTRY_DSN=https://REPLACE@REPLACE.ingest.sentry.io/REPLACE
SENTRY_ORG=mipueblo-flea-market
SENTRY_PROJECT=shop-web
SENTRY_AUTH_TOKEN=REPLACE_WITH_SENTRY_AUTH_TOKEN

# ─── POSTHOG (Analytics) ─────────────────────────────────────────────────────
# app.posthog.com o self-hosted
NEXT_PUBLIC_POSTHOG_KEY=phc_REPLACE_WITH_POSTHOG_KEY
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
# En producción: https://analytics.shop.mipueblofleamarket.com

# ─── INTERNACIONALIZACIÓN ────────────────────────────────────────────────────
NEXT_PUBLIC_DEFAULT_LOCALE=es
NEXT_PUBLIC_LOCALES=es,en

# ─── FEATURE FLAGS (activar/desactivar módulos) ──────────────────────────────
FEATURE_VIDEO_UPLOAD=true
FEATURE_VENDOR_SHIPS=true
FEATURE_MIPUEBLO_SHIPS=true
FEATURE_TAX_CALCULATION=true
FEATURE_TIKTOK_SHOP=false

# ─── MISC ────────────────────────────────────────────────────────────────────
# Máximo tamaño de archivo para uploads (bytes)
MAX_IMAGE_SIZE_BYTES=10485760
MAX_VIDEO_SIZE_BYTES=104857600
# Stock reservation timeout en minutos
STOCK_RESERVATION_MINUTES=15
# Ventana de retención antes de payout (días)
PAYOUT_HOLD_DAYS=7
